# ============================================================
# .env.example — Template Environment Variables
# Salin file ini: cp .env.example .env
# Kemudian isi nilai yang sesuai
# JANGAN commit file .env ke Git
# ============================================================

# ── Application ─────────────────────────────────────────────
APP_KEY=                          # Generate dengan: php artisan key:generate

# ── Database ─────────────────────────────────────────────────
DB_ROOT_PASSWORD=rootpassword_ganti_ini
DB_USERNAME=pos_user
DB_PASSWORD=pos_password_ganti_ini

# ── Catatan ──────────────────────────────────────────────────
# DB_HOST, KAFKA_BROKERS, dan variabel koneksi antar container
# sudah diset langsung di docker-compose.yml sebagai nama service.
# Tidak perlu diset ulang di sini.
